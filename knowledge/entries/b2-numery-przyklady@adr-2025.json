        "20": "gaz duszący",
        "23": "gaz palny",
        "80": "materiał żrący",
        "88": "materiał silnie żrący"
      }
    },
    "scenario": {
      "prompt": "Cysterna z tablica 33 / 1203 przewozi:",
      "options": [
        "Chlor",
        "Benzynę",
        "Azotan amonu"
      ],
      "correct": "Benzynę"
    }

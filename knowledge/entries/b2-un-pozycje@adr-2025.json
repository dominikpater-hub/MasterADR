      "prompt": "UN 1263 FARBA to przykład:",
      "options": [
        "Jednej substancji",
        "Pozycji grupowej",
        "Numeru zagrożenia"
      ],
      "correct": "Pozycji grupowej"
    },
    "match": {
      "prompt": "Dopasuj numer UN do typu pozycji:",
      "pairs": {
        "UN 1090 ACETON": "jedna substancja",
        "UN 1263 FARBA": "pozycja grupowa"
      }
    },
    "scenario": {
      "prompt": "Numer UN nazywany jest również numerem:",
      "options": [
        "Kemlera",
        "ONZ",
        "rozpoznawczym zagrożenia"
      ],
      "correct": "ONZ"
    }
